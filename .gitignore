.idea/
.vscode/
*.swp

# macOS
.DS_Store

# OMC tool state
.omc/
.omx/

# Local virtualenv inside vendored OpenReview supplement
code/harness/rolora-supplement/RoLoRA-code/.venv-supplement/

# Local data and run outputs
data/
exp/
results/*
!results/.gitkeep
slurm-*.out
slurm_logs/
*.ckpt
*.pt
wandb/
mlruns/

# Committed run registry: runs/ IS tracked (shareable per-run log+metrics+config).
# Re-include the logs that the global *.log / *.out rules above would drop.
# Checkpoints/wandb never land here, and stay ignored via *.ckpt / wandb/ anyway.
!runs/**/*.log
!runs/**/*.out
# HuggingFace cache accidentally created under supplement data dir
code/harness/rolora-supplement/RoLoRA-code/sst2/models--*/
code/harness/rolora-supplement/RoLoRA-code/sst2/.locks/

# Generated presentation inspection thumbnails
docs/presentations/**/source-thumbnails/
docs/presentations/**/preview-screenshots*/

.env
docs/presentations/**/paper-page-previews/
